# Copie para deploy/vps/.env. Fixe as imagens por digest (docker pull + docker image inspect).
NODE_IMAGE=node:24-alpine
GATEWAY_IMAGE=nginx:1.29-alpine
CADDY_IMAGE=caddy:2.10-alpine

# Subdomínio com registro DNS A apontando para a VPS.
PUBLIC_DOMAIN=leituras.seudominio.com
# IP público onde o Caddy escuta. Use um IP específico se outra coisa (ex.: tailscale serve) já ocupa a 443.
PUBLIC_IP=0.0.0.0
