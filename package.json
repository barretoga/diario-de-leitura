{
  "name": "reading-log",
  "private": true,
  "version": "0.1.0",
  "engines": { "node": ">=24.15.0" },
  "packageManager": "pnpm@8.6.12",
  "workspaces": ["apps/*"],
  "scripts": {
    "dev": "node scripts/dev-launch.cjs",
    "dev:test": "node scripts/dev-launch.cjs --test",
    "start": "pnpm --filter @reading-log/mobile start",
    "typecheck": "pnpm --filter @reading-log/mobile typecheck",
    "server:start": "pnpm --filter @reading-log/server start",
    "server:test": "pnpm --filter @reading-log/server test",
    "mobile:test": "pnpm --filter @reading-log/mobile test",
    "test": "pnpm dev:test && pnpm server:test && pnpm mobile:test"
  }
}
