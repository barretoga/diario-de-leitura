# Gere um valor aleatório de pelo menos 32 caracteres e copie este arquivo para .env.
READING_LOG_TOKEN=
API_PORT=8080
# Dominio publico (HTTPS via Caddy): docker compose --profile proxy up -d --build
PUBLIC_DOMAIN=leituras.seudominio.com
KOREADER_TIME_ZONE=America/Sao_Paulo

# Somente para a instancia central: docker compose -f compose.catalog.yaml up --build -d
# Nao colocar esta chave no app, em variaveis EXPO_PUBLIC_, em backups ou logs.
GOOGLE_BOOKS_API_KEY=
CATALOG_CONTACT_EMAIL=
CATALOG_PORT=8081
